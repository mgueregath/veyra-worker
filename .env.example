VEYRA_WORKER_VERSION=0.4.0
# --- obligatorias ---
VEYRA_API_URL=http://10.0.0.51:8899
VEYRA_WORKER_TOKEN=            # lo entrega Veyra al registrar el worker (Gestión → Sistema)
# --- carpeta compartida (NFS), la misma que monta la API ---
VEYRA_NFS_ADDR=192.168.1.34
VEYRA_NFS_DEVICE=:/mnt/main/veyra   # requiere crear ese dataset/export en el NAS (hoy no existe)
# --- opcionales ---
VEYRA_WORKER_NAME=gpu-rtx4080
VEYRA_ADVERTISE_HOST=10.0.0.4  # dirección con la que la API alcanza a este equipo (flujos en vivo)
VEYRA_DEVICE=0
VEYRA_LIVE_PORTS=9000-9099
VEYRA_MAX_LIVE=2
VEYRA_MAX_BATCH=1
# VEYRA_HEARTBEAT=5                        # segundos entre latidos (así se entera de las cancelaciones)
# VEYRA_PRETRAINED_DIRS=/data/pretrained   # carpetas con pesos yolov8n.pt, etc. (además de la compartida)
# --- espacios de trabajo (VS Code por SSH, un contenedor por proyecto) ---
VEYRA_WORKSPACES=1
VEYRA_DATA_VOLUME=veyra-worker_veyra_data   # nombre del volumen NFS de este compose (se monta en /data, solo lectura)
VEYRA_WORKSPACE_IMAGE=docker.labs.hapticus.cl/veyra-workspace:0.4.0
VEYRA_WORKSPACE_PORTS=9100-9199
VEYRA_MAX_WORKSPACES=4
DOCKER_GID=999                              # grupo «docker» del equipo (getent group docker)
