#!/bin/sh
# veyra-apt install <paquetes…>: instala y lo anota en packages.apt (versionado) para reinstalarlo en cada arranque.
[ "$1" = install ] || { echo "uso: veyra-apt install <paquete>..."; exit 2; }
shift
sudo apt-get update -qq && sudo apt-get install -y "$@" || exit $?
for p in "$@"; do grep -qx "$p" /workspace/project/packages.apt 2>/dev/null || echo "$p" >> /workspace/project/packages.apt; done
echo "anotado en /workspace/project/packages.apt"
