#!/usr/bin/env python3
"""Ejecutor de procedimientos del espacio de trabajo (lo invoca el worker en un contenedor aislado).

    veyra-proc list [--ref REF]
    veyra-proc run --name NOMBRE --ref REF --images lista.json --params params.json --out resultado.json

Los procedimientos los declara el repositorio del proyecto en `veyra.yaml` (o `veyra.json`):

    procedures:
      - name: manchas
        entry: lice_motion.veyra:manchas        # módulo:función
        doc: Detector de manchas por apariencia
        params: {k: 8, min_score: 4.0}

La función recibe la imagen (BGR, numpy) y los parámetros como argumentos con nombre, y devuelve una lista de
{"bbox": [x, y, w, h], "score": 0.9, "label": "opcional"}. Se ejecuta el código de un COMMIT concreto (`--ref`,
por defecto HEAD): lo que no esté confirmado en git no se usa, así cada resultado se puede reproducir.
"""

import argparse
import json
import os
import sys
import traceback
from pathlib import Path

VENV_PY = Path("/workspace/.venv/bin/python")

from veyra_worker.scripts import procs  # noqa: E402  (módulo compartido con los flujos en vivo)


def fail(e: Exception):
    raise SystemExit(str(e)) from None


def cmd_list(a) -> int:
    try:
        sha = procs.resolve(a.ref)
        listed, err = procs.manifest(procs.checkout(sha))
    except procs.ProcError as e:
        fail(e)
    print(json.dumps({"ref": sha, "procedures": listed, "error": err}))
    return 0


def cmd_run(a) -> int:
    if VENV_PY.exists() and Path(sys.prefix) != Path("/workspace/.venv") and not os.environ.get("VEYRA_PROC_NO_EXEC"):
        os.environ["VEYRA_PROC_NO_EXEC"] = "1"  # con el entorno virtual del proyecto (ahí están sus dependencias)
        os.execv(str(VENV_PY), [str(VENV_PY), *sys.argv])
    try:
        fn, defaults, sha = procs.load(a.name, a.ref)
    except procs.ProcError as e:
        fail(e)
    params = {**defaults, **json.loads(Path(a.params).read_text())}
    import cv2

    images = json.loads(Path(a.images).read_text())
    results = {}
    for i, path in enumerate(images, 1):
        img = cv2.imread(path)
        if img is None:
            results[path] = []
            continue
        try:
            dets = fn(img, **params)
        except Exception:
            print(f"ERROR en {path}:\n{traceback.format_exc()[-1500:]}", flush=True)
            return 3
        out = []
        for d in dets or []:
            x, y, w, h = (float(v) for v in d["bbox"])
            if w <= 0 or h <= 0:
                continue
            out.append({"bbox": [round(x), round(y), round(w), round(h)], "score": float(d.get("score", 1.0)), "label": d.get("label") or ""})
        results[path] = out
        if i % 10 == 0:
            print(f"PROGRESS {i}/{len(images)}", flush=True)
    Path(a.out).write_text(json.dumps({"ref": sha, "results": results}))
    print(f"LISTO {len(images)} imágenes con {sha[:8]}", flush=True)
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="veyra-proc")
    sub = ap.add_subparsers(dest="cmd", required=True)
    ls = sub.add_parser("list")
    ls.add_argument("--ref", default="HEAD")
    rn = sub.add_parser("run")
    rn.add_argument("--name", required=True)
    rn.add_argument("--ref", default="HEAD")
    rn.add_argument("--images", required=True)
    rn.add_argument("--params", required=True)
    rn.add_argument("--out", required=True)
    a = ap.parse_args()
    return cmd_list(a) if a.cmd == "list" else cmd_run(a)


if __name__ == "__main__":
    sys.exit(main())
